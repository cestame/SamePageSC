modules = ["nodejs-20", "postgresql-16"]
run = ["sh", "-c", "npm install && npm run build && npm start"]

[nix]
channel = "stable-24_05"

[deployment]
build = ["sh", "-c", "npm ci && npm run build"]
run = ["npm", "start"]
deploymentTarget = "autoscale"

[[ports]]
localPort = 3000
externalPort = 80

[env]
PORT = "3000"
