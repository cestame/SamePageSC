# Required for AI profile extraction and match explanations. On Replit, add it under Secrets.
ANTHROPIC_API_KEY=
# Set automatically when you add a PostgreSQL database on Replit. If unset, an embedded
# database (PGlite) is stored in ./data so the app still runs locally.
DATABASE_URL=
# Optional: code professors enter to get a "Verified professor" badge on their response.
PROFESSOR_RESPONSE_CODE=
# Optional: override the model (defaults to claude-opus-5-5).
ANTHROPIC_MODEL=
