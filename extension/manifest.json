{
  "manifest_version": 3,
  "name": "Same Page",
  "version": "0.1.0",
  "description": "Shows how each section in USC Web Registration fits the way you learn, from notes by students who took it.",
  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "Open Same Page", "default_icon": { "16": "icons/icon-16.png", "48": "icons/icon-48.png" } },
  "side_panel": { "default_path": "panel/index.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["http://localhost:3000/*", "https://*.replit.app/*", "https://*.replit.dev/*"],
  "content_scripts": [
    {
      "matches": ["https://webreg.usc.edu/*"],
      "js": ["webreg.js"],
      "run_at": "document_idle"
    }
  ]
}
