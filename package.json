{
  "name": "trojan-fit",
  "version": "0.1.0",
  "description": "Professor-student course matching for USC: teaching profiles built from student notes, matched to how you learn.",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "build": "vite build",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test server/*.test.js extension/test/*.test.js evals/**/*.test.js",
    "build:extension": "node extension/scripts/build-content.mjs",
    "eval:explanations": "node evals/explanations/run.js",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cestame/aiusc.git"
  },
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/cestame/aiusc/issues"
  },
  "homepage": "https://github.com/cestame/aiusc#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@electric-sql/pglite": "^0.5.16",
    "@phosphor-icons/react": "^2.1.10",
    "express": "^4.22.3",
    "motion": "^14.14.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.4.6"
  }
}
